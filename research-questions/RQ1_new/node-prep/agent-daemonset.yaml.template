# Node agent: (1) PINS CPU FREQUENCY, (2) mounts the host results path so the
# sweep can read jobs.csv off the node. One per model node (nodeSelector).
# Rendered + applied by apply.sh (fills @@NS@@ / @@LK@@ / @@LV@@ / @@HOST_PATH@@).
apiVersion: v1
kind: Namespace
metadata: { name: "@@NS@@" }
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  namespace: "@@NS@@"
  name: rq1-agent
  labels: { app: rq1-agent }
spec:
  selector: { matchLabels: { app: rq1-agent } }
  template:
    metadata: { labels: { app: rq1-agent } }
    spec:
      hostPID: true
      nodeSelector: { "@@LK@@": "@@LV@@" }
      tolerations: [{ operator: Exists }]
      containers:
        - name: agent
          image: ubuntu:24.04
          securityContext: { privileged: true }
          command: ["/bin/bash","-c"]
          args:
            - |
              set -x
              # --- PIN CPU FREQUENCY (intel_pstate; verified on Azure D4s_v5) -----
              # governor (harmless if intel_pstate ignores it)
              for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
                echo performance > "$g" 2>/dev/null || true
              done
              # disable turbo, then pin the P-state to 100% of base -> fixed clock.
              # (scaling_max_freq is NOT writable under intel_pstate active mode;
              #  min_perf_pct == max_perf_pct is what actually pins the frequency.)
              echo 1   > /sys/devices/system/cpu/intel_pstate/no_turbo      2>/dev/null || true
              echo 100 > /sys/devices/system/cpu/intel_pstate/min_perf_pct  2>/dev/null || true
              echo 100 > /sys/devices/system/cpu/intel_pstate/max_perf_pct  2>/dev/null || true
              echo 0   > /sys/devices/system/cpu/cpufreq/boost              2>/dev/null || true  # non-pstate fallback
              # --- verify + LOG what actually stuck (so it's recorded, not silent) --
              echo "[agent] no_turbo=$(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null)"
              echo "[agent] perf_pct min=$(cat /sys/devices/system/cpu/intel_pstate/min_perf_pct 2>/dev/null) max=$(cat /sys/devices/system/cpu/intel_pstate/max_perf_pct 2>/dev/null)"
              echo "[agent] governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"
              echo "[agent] cur_freq cpu0=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null) cpu2=$(cat /sys/devices/system/cpu/cpu2/cpufreq/scaling_cur_freq 2>/dev/null)"
              mkdir -p "/host@@HOST_PATH@@"
              echo "[agent] ready; results at /host@@HOST_PATH@@"
              sleep infinity
          volumeMounts:
            - { name: sysfs, mountPath: /sys }
            - { name: results, mountPath: "/host@@HOST_PATH@@" }
      volumes:
        - name: sysfs
          hostPath: { path: /sys }
        - name: results
          hostPath: { path: "@@HOST_PATH@@", type: DirectoryOrCreate }
