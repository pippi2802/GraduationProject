# Results are regenerated by runs, never hand-edited.
results/*
!results/.gitkeep

# Build artefacts
stress/enemy
stress/victim
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/

# Video: regenerated by workload/videos/prepare_clip.sh from a downloaded
# archive - keep the clip_metadata.json (small, provenance) but not the
# multi-gigabyte source or the generated media.
workload/videos/*.tar.gz
workload/videos/*.tar.xz
workload/videos/*.y4m
workload/videos/*.mp4
workload/videos/Unconfirmed*
