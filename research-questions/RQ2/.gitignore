# Results are regenerated by runs, never hand-edited.
results/*
!results/.gitkeep

# Build artefacts
stress/enemy
stress/victim
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/

# Video: regenerated by workload/videos/prepare_clip.sh from a downloaded
# archive - keep the clip_metadata.json (small, provenance) but not the
# multi-gigabyte source or the generated media.
workload/videos/*.tar.gz
workload/videos/*.tar.xz
workload/videos/*.y4m
workload/videos/*.mp4
workload/videos/Unconfirmed*

# alpha_drift runs (same rule as results/)
alpha_drift/results/*
!alpha_drift/results/.gitkeep

# validation runs (same rule as results/)
validation/results/*
!validation/results/.gitkeep

# workload2 (segmentation): the dataset (4 GB) and the collected results
workload2/archive/
workload2/results/*
workload2/aeroscapes/

# workload3 (audio): collected results
workload3/results/*
workload3/alpha_drift/results/
