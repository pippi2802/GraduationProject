# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# RQ1_new generated manifests (regenerable via generate_yaml.py) -- covers
# the bare matmul dir AND every generated_<workload> variant (generated_primes
# etc). Found 2026-08-18: generated_primes/ was never covered by the old
# narrower pattern, so it got committed once early (stale v2 image baked in)
# and silently kept getting reused by run_job.sh across every subsequent
# model1 primes attempt, since run_job.sh has no way to know the manifests
# on disk are stale -- it just reads whatever's there.
research-questions/RQ1/models/*/generated/
research-questions/RQ1/models/*/generated_*/

# stray shell-redirect artifacts occasionally created by mistyped loops
research-questions/RQ1/awk
research-questions/RQ1/done
research-questions/RQ1/echo

research-questions/RQ1/.venv
research-questions/RQ1/analysis/clean_data

# compiled probe binary (regenerable via `make`)
research-questions/RQ1/matmul
