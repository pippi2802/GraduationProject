# Keep LF for files that run on Linux (worker/control-plane), regardless of
# the checkout platform. Prevents CRLF from breaking shebangs (e.g.
# "/bin/bash^M: bad interpreter") and YAML/Make whitespace.
*.sh    text eol=lf
*.bash  text eol=lf
Makefile text eol=lf
*.mk    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.tmpl  text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.py    text eol=lf
