# Normalize line endings across platforms. This repo targets Linux (k8s nodes,
# containers, bash scripts), so text files are stored and checked out as LF.
# Without this, Windows' core.autocrlf=true would rewrite scripts to CRLF and
# break their shebangs on Linux ("bad interpreter").

# Default: treat everything as text and normalize to LF on checkout.
* text=auto eol=lf

# Files that MUST be LF (executed on Linux) — be explicit regardless of autocrlf.
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf
*.c     text eol=lf
*.h     text eol=lf

# Windows-specific scripts stay CRLF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binary files: never touch line endings.
*.png   binary
*.pdf   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.gz    binary
*.tar   binary
*.zip   binary
